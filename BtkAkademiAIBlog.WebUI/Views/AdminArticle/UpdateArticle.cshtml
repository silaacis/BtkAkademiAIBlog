@model GetArticleByIdDto
@{
    ViewData["Title"] = "UpdateArticle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<main class="page-content">
    <!--breadcrumb-->
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3">Makaleler</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Yeni Makale Güncelleme Sayfası</li>
                </ol>
            </nav>
        </div>
    </div>
    <!--end breadcrumb-->

    <div class="card">
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="ArticleId" />
                <label>Makale Başlığı:</label>
                <input type="text" class="form-control" asp-for="Title" />
                <br />
                <label>Kapak Resmi Thumbnail URL:</label>
                <input type="text" class="form-control" asp-for="CoverImageUrl" />
                <br />
                <label>Makale Detayı Ana Resim URL:</label>
                <input type="text" class="form-control" asp-for="MainImageUrl" />
                <br />
                <label>Kategori:</label>
                <select asp-for="CategoryId"
                        class="form-control"
                        asp-items="@((IEnumerable<SelectListItem>)ViewBag.CategoryValues)">
                    <option value="">--Kategori Seçiniz--</option>
                </select>
                <br />
                <label>Öne Çıkan (Feature) Slider Görsel URL:</label>
                <input type="text" class="form-control" asp-for="FeatureSliderImageUrl" />
                <br />
                <label>Öne Çıkan (Feature) Görsel URL:</label>
                <input type="text" class="form-control" asp-for="FeatureImageUrl" />
                <br />
                <label>Yazar Bilgisi:</label>
                <input type="text" class="form-control" asp-for="Title" />
                <br />
                <label>Makale İçeriği:</label>
                <textarea class="form-control" asp-for="Content"></textarea>
                <br />

                <button class="btn btn-success">Makaleyi Güncelle</button>
            </form>
        </div>
    </div>


</main>