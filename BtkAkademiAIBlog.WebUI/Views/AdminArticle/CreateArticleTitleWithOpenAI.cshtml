
@{
    ViewData["Title"] = "CreateArticleTitleWithOpenAI";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<main class="page-content">
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3">Yapay Zeka Destekli Makale Asistanı</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="/AdminArticle/ArticleList"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">OpenAI Makale Başlık Oluşturucu</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h4 class="mb-3">AI ile Başlık Oluştur</h4>

            <form method="post">
                <label>Makale Konusu</label>
                <input type="text"
                       name="topic"
                       class="form-control mb-3"
                       placeholder="Örn: Yapay zekanın yazılım sektörüne etkisi" />

                <button type="submit" class="btn btn-success">
                    Başlık Oluştur
                </button>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">
                    @ViewBag.Error
                </div>
            }
        </div>
    </div>

    @if (ViewBag.ArticleTitle != null)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="mb-3">Oluşturulan Makale Başlığı</h5>

                <div class="border rounded p-3 bg-light">
                    @Html.Raw(ViewBag.ArticleTitle.Replace("\n", "<br/>"))
                </div>
            </div>
        </div>
    }
</main>

